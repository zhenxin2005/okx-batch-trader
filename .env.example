# OKX API 配置
# 请替换为你的真实 API 密钥，切勿泄露给他人！

# OKX API Key
OKX_API_KEY=your_api_key_here

# OKX Secret Key
OKX_SECRET_KEY=your_secret_key_here

# OKX API Passphrase (创建 API 时设置的密码)
OKX_PASSPHRASE=your_passphrase_here

# 是否使用模拟交易 (True=模拟, False=实盘)
# 强烈建议先使用模拟交易测试！
OKX_USE_DEMO=True

# OKX API 域名（可选，默认 https://www.okx.com）
# 国内用户如果连接失败，可尝试: https://www.okx.cab 或 https://www.okx.com
# OKX_DOMAIN=https://www.okx.com

# 代理配置（可选）
# 默认走 OKX 客户端的 SOCKS5 代理；也可改成其他代理，如 Clash: http://127.0.0.1:7890
# OKX_PROXY=socks5://127.0.0.1:17001